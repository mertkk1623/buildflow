# BuildFlow AI — frontend ortam değişkenleri
#
# Kopyalayın:  Copy-Item .env.example .env
#
# VITE_API_BASE_URL
#   Boş bırakılırsa istekler görece `/api/...` olarak gider ve Vite proxy'si
#   (aşağıdaki VITE_PROXY_TARGET) devreye girer. Tarayıcıda CORS sorunu olmaz.
#
#   Doluysa (ör. http://127.0.0.1:8000) istekler doğrudan o adrese gider.
#   Bu durumda backend'in BUILDFLOW_CORS_ORIGINS listesinde frontend adresi
#   bulunmalıdır.
VITE_API_BASE_URL=

# Vite geliştirme sunucusunun proxy hedefi.
# Yalnızca geliştirme içindir; üretim derlemesini etkilemez.
VITE_PROXY_TARGET=http://127.0.0.1:8000
