# Bu dosyayı `.env` olarak kopyalayın ve yerel değerlerinizi girin.
# `.env` dosyası Git'e eklenmez.

BUILDFLOW_ENVIRONMENT=development

# Uygulama adı (OpenAPI başlığı). Varsayılan yeterlidir.
# BUILDFLOW_APP_NAME=BuildFlow AI API

# Metraj şablonunun sunucudaki yolu. Varsayılan: depo kökündeki
# templates/metraj_sablonu.xlsx. Yalnızca farklı bir konum kullanacaksanız
# doldurun; istemciden gelen hiçbir ad buraya yazılmaz.
# BUILDFLOW_TEMPLATE_PATH=templates/metraj_sablonu.xlsx

# İzin verilen tarayıcı origin'leri (JSON listesi).
# Geliştirme: Vite sunucusu. Üretimde yalnızca gerçek alan adını yazın.
# Joker ("*") kabul edilmez; boş liste tarayıcı isteklerini reddeder.
BUILDFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Yükleme boyutu üst sınırı (bayt). Varsayılan 10 MB.
BUILDFLOW_MAX_UPLOAD_BYTES=10485760

# --- AI eşleştirme (Aşama 4.5) ---
# Varsayılan "none": AI kapalı, hiçbir ağ çağrısı yapılmaz ve sistem
# deterministik eşleştirmeyle aynı sonucu verir. Aşağıdaki üç değer
# doldurulmadan AI etkinleşmez.
BUILDFLOW_AI_PROVIDER=none
# BUILDFLOW_AI_PROVIDER=openai-compatible
# BUILDFLOW_AI_BASE_URL=https://api.openai.com/v1
# BUILDFLOW_AI_MODEL=gpt-4o-mini
# Yalnızca ortam değişkeninden okunur; yanıtta ve logda görünmez.
# BUILDFLOW_AI_API_KEY=
# İstek zaman aşımı (saniye). Aşımda satır pending kalır.
# BUILDFLOW_AI_TIMEOUT_SECONDS=10
